# Copy to .env for Docker Compose. The Python app itself does not load .env.
# Generate a token: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BIOGRAPH_ACCESS_TOKEN=
BIOGRAPH_PORT=8766
BIOGRAPH_PUBLISH_HOST=127.0.0.1
# Exact HTTPS origin of your Brev Secure Link, without a path; blank for SSH forwarding.
BIOGRAPH_ALLOWED_ORIGINS=

# Shared planner/verifier configuration. Fill in the workspace's actual values.
# nim_chat uses guided_json + max_tokens; chat_completions uses response_format.
BIOGRAPH_MODEL_PROVIDER=nim
BIOGRAPH_MODEL_ID=
BIOGRAPH_MODEL_ENDPOINT=
BIOGRAPH_MODEL_API=nim_chat
BIOGRAPH_MODEL_API_KEY=
# Optional role overrides: BIOGRAPH_PLANNER_* and BIOGRAPH_VERIFIER_*.
# Standard prompts are the default. Nano v1's explicit reasoning-off contract:
# BIOGRAPH_PLANNER_PROMPT_PROFILE=nemotron_nano_v1
# Explicit tool shapes/scope guards; catalogue_v1 and entity_tools_v2 are retained.
# BIOGRAPH_PLANNER_PROTOCOL=tool_shapes_v3
# In a VM, BIOGRAPH_DATA_DIR can point to a persistent absolute directory.
