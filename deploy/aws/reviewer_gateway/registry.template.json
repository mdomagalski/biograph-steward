{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private immutable image repository for the optional authenticated reviewer gateway. Does not deploy a service.",
  "Resources": {
    "GatewayRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {"ScanOnPush": true},
        "EncryptionConfiguration": {"EncryptionType": "AES256"}
      }
    }
  },
  "Outputs": {
    "RepositoryUri": {"Value": {"Fn::GetAtt": ["GatewayRepository", "RepositoryUri"]}},
    "RepositoryName": {"Value": {"Ref": "GatewayRepository"}}
  }
}
