worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 1024; }
http {
    # Never log query strings, Authorization, cookies, response bodies or tokens.
    log_format review '$request_method $uri $status $body_bytes_sent $request_time';
    access_log /dev/stdout review;
    server_tokens off;
    client_max_body_size 64k;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    send_timeout 600s;
    client_body_timeout 30s;
    gzip off;
    # Keep sufficient space if a reviewed literal map key is added later.
    map_hash_bucket_size 256;

__PUBLIC_MAPS__
    map $request_method $public_read_method { default 0; ~^GET$ 1; ~^HEAD$ 1; }
    map "$public_read_method:$public_get_target:$public_post_target" $public_allowed {
        default 0;
        "1:1:0" 1;
        "0:0:1" 1;
    }
    # Reject percent-encoded paths, even if NGINX normalizes one to an allowed URI.
    # Raw queries have their own complete grammar in the generated map above.
    upstream steward { server __UPSTREAM_IPV4__:8768; }
    server {
        listen 8080;
        default_type text/plain;
        error_page 403 =403 @public_demo_only;
        location @public_demo_only {
            default_type application/json;
            return 403 '{"error":"This public demo opens approved saved evidence only. New questions, model calls, edits and bulk source downloads require the separate operator application."}';
        }
        location = /auth/login { return 303 /; }
        location = /auth/logout { return 303 /; }
        location / {
            if ($public_raw_path_safe = 0) { return 403; }
            if ($public_allowed = 0) { return 403; }
            proxy_pass http://steward;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header Origin $http_origin;
            # This placeholder is substituted only at container startup.
            proxy_set_header Authorization "Bearer ${BIOGRAPH_SERVER_TOKEN}";
            proxy_set_header Cookie "";
            proxy_hide_header Set-Cookie;
            proxy_set_header Accept-Encoding $public_upstream_accept_encoding;
            proxy_connect_timeout 10s;
            proxy_read_timeout 600s;
            proxy_send_timeout 600s;
            proxy_next_upstream off;
            proxy_cache off;
            proxy_buffering off;
            proxy_request_buffering on;
            proxy_intercept_errors off;
            proxy_redirect off;
            # Only presentation controls are hidden. The maps and separate
            # read-only snapshot enforce access independently of this CSS/JS.
__PUBLIC_SUBFILTERS__
        }
    }
}
