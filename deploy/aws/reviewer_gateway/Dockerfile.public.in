FROM __NGINX_IMAGE__
RUN apk add --no-cache 'libxslt=1.1.43-r4' 'zlib=1.4-r0'
COPY --chmod=0644 nginx.conf /etc/nginx/nginx.public.conf.template
COPY --chmod=0755 public-entrypoint.sh /usr/local/bin/biograph-public-entrypoint
USER 101:101
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/biograph-public-entrypoint"]
CMD ["-g", "daemon off;"]
