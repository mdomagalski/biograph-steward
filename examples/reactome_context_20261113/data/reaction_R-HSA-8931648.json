"stIdVersion":"R-MMU-8931648.1","isInDisease":false,"isInferred":true,"maxDepth":1,"name":["B3GALNT2 transfers GalNAc to GlcNAc-Man-DAG1"],"releaseDate":"2026-09-16","speciesName":"Mus musculus","inferredFrom":[8931648],"category":"transition","className":"Reaction","schemaClass":"Reaction"}],"species":[{"dbId":48887,"displayName":"Homo sapiens","name":["Homo sapiens","H. sapiens","Hs","human","man"],"taxId":"9606","abbreviation":"HSA","className":"Species","schemaClass":"Species"}],"summation":[{"dbId":8931651,"displayName":"ER membrane-associated UDP-GalNAc:beta-1,3-N-acetylgalactosa...","text":"ER membrane-associated UDP-GalNAc:beta-1,3-N-acetylgalactosaminyltransferase 2 (B3GALNT2) transfers N-acetylgalactosamine (GalNAc) from UDP-GalNAc to GlcNAc-Man-DAG1 via a 1-3 glycosidic bond (Hiruma et al. 2004, Yoshida-Moriguchi et al. 2013). Alpha-dystroglycan (DAG1) is required for binding laminin G-like domain-containing extracellular proteins with high affinity. Defects in B3GALNT2 can cause muscular dystrophy-dystroglycanopathy congenital with brain and eye anomalies A11 (MDDGA11; MIM:615181), a hypoglycosylation defect resulting in a reduced ability of DAG1 to bind laminin and other extracellular matrix ligands. The disorder is characterised by dystroglycanopathy with muscle and brain anomalies (Stevens et al. 2013).","className":"Summation","schemaClass":"Summation"}],"reviewStatus":{"dbId":9821382,"displayName":"five stars","definition":"externally reviewed","name":["five stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"previousReviewStatus":{"dbId":9821385,"displayName":"four stars","definition":"structure upated after externally reviewed and then internally reviewed","name":["four stars"],"className":"ReviewStatus","schemaClass":"ReviewStatus"},"isChimeric":false,"category":"transition","catalystActivity":[{"dbId":8931635,"displayName":"acetylgalactosaminyltransferase activity of B3GALNT2 [endoplasmic reticulum membrane]","catalyzedEvent":[8931